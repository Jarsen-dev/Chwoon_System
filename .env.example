# Base de datos
DATABASE_URL=postgresql+asyncpg://planta_user:password123@db:5432/planta_db

# Frontend
# NOTA: la IP debe ser la IP/hostname de VPN (Tailscale) de la máquina que corre
# ESTE stack (docker-compose.local.yml) — cambia por equipo, no es fija.
NEXT_PUBLIC_API_URL=http://100.115.152.13:8000
NEXT_PUBLIC_APP_URL=http://100.115.152.13:3000
NEXT_PUBLIC_WS_URL=ws://100.115.152.13:8000

# CORS — orígenes permitidos para llamar al backend directo (bypass del proxy de Next),
# por ejemplo desde la IP de VPN usada arriba.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5050,http://100.115.152.13:3000

# Gateway de máquinas EPS — clave compartida que el script Python (gateway PLC/HMI)
# usa en el header X-API-Key al hacer POST /maquinas/evento. Generar un valor largo y aleatorio.
GATEWAY_API_KEY=13QJBIcs1K98otCw3O8n9s5v7X2a4Z0eL6rYpF4hWjNqR0uVxM
# Servidor Ollama local para OCR de remisiones (Panel de Almacén → Recepciones
# por Foto). La clasificación de formato es local (Tesseract + TF-IDF, no usa
# Ollama); OLLAMA_TEXT_MODEL solo estructura el texto ya leído por OCR a JSON
# — por eso basta un modelo de texto liviano, no uno de visión.
OLLAMA_HOST=http://192.168.1.56:11434
OLLAMA_TEXT_MODEL=llama3.2:latest
# Umbral de similitud coseno (TF-IDF) para clasificar el tipo de documento;
# ajustar según resultados reales (ver logs "clasificación TF-IDF" del backend).
OCR_UMBRAL_SIMILITUD=0.20

# --- Etiquetas de lote (Zebra ZD220) ---
# Nombre EXACTO de la cola de Windows. Debe coincidir con el IMPRESORA del
# agente (gateway/agente_impresion.py); si no, los trabajos nunca se reclaman.
# Verlo en Windows con:  Get-Printer | Select-Object Name
IMPRESORA_ETIQUETAS=ZDesigner ZD220-203dpi ZPL

# --- Etiquetas de lote en hoja carta (HP de red) ---
# Esta sí la alcanza el contenedor, así que el backend le manda el PDF él mismo
# por TCP raw; no interviene el agente de Windows.
IMPRESORA_CARTA_HOST=192.168.1.250
IMPRESORA_CARTA_PORT=9100
IMPRESORA_CARTA_NOMBRE=HP Color LaserJet MFP E78625
