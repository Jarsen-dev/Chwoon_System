*.pdf
*.xlsxdocker-compose.local.yml

# ── Env files ───────────────────────────────────
.env
.env.example
.env.local
.env.production
*.env

# ── pgAdmin generado ────────────────────────────
pgadmin/pgpass

# ── OpenCode ────────────────────────────────────
.opencode/
# ── Ayudas Visuales (espejo del share SMB del Synology + miniaturas — no van al repo) ──
backend/static/ayudas_visuales/
